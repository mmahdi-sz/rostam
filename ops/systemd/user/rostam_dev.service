[Unit]
Description=Rostam Telegram Bot (Dev)
After=network.target postgresql.service

[Service]
Type=simple
WorkingDirectory=/mnt/data/mahdidev/ros/dev
EnvironmentFile=/mnt/data/mahdidev/ros/dev/.env
Environment=LD_LIBRARY_PATH=/mnt/data/mahdidev/ros/dev/files/runtime
ExecStartPre=/usr/bin/pg_isready -h localhost -p 5432 -t 30
ExecStart=/mnt/data/mahdidev/ros/dev/target/debug/rostam-dev
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
