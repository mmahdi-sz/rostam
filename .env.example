# Required
BOT_TOKEN=put-your-telegram-bot-token-here

# Optional: use a local telegram-bot-api server.
# Frankenstein receives the full API URL as http://127.0.0.1:8081/bot<TOKEN>.
BOT_API_BASE_URL=http://127.0.0.1:8081
# When the local Bot API runs in --local mode it hands back absolute file paths;
# downloads are only copied if they resolve inside this directory (a guard
# against reading arbitrary files off the host). Default: /var/lib/telegram-bot-api
TELEGRAM_LOCAL_STORAGE_DIR=/var/lib/telegram-bot-api
DATABASE_URL=postgres://postgres:postgres@localhost:5432/ros_telegram_bot
REDIS_URL=redis://127.0.0.1:6379

# Telegram user ID that gets admin panel access + emoji-cache management.
ADMIN_USER_ID=

# Marks this process as dev (relaxes some checks) — leave unset in production.
DEV_MODE=false
# Short label shown in logs/Redis lock ownership to tell dev/prod apart.
ENV_LABEL=dev

# ── Paths ──────────────────────────────────────────────────────────────────
# All paths below default to a location relative to the process's working
# directory, so a single dev+prod pair running out of separate directories
# never collide unless you explicitly point them at the same place.

# Where in-flight YouTube downloads are staged before upload. Default: downloads/yt
YOUTUBE_DOWNLOAD_ROOT=downloads/yt
# Where the `surge` direct-link downloader tool stages files. Default: downloads/surge
SURGE_DOWNLOADS_ROOT=downloads/surge
# host:port of the running `surge server` daemon. Default: 127.0.0.1:1700
SURGE_HOST=127.0.0.1:1700

# ── Cookie pool (YouTube auth) ───────────────────────────────────────────────
# Root directory containing Firefox profiles used for yt-dlp cookie discovery.
# Defaults to $HOME/.mozilla/firefox if unset.
FIREFOX_PROFILES_ROOT=
# Path to the `deno` binary passed to yt-dlp's --js-runtimes flag.
# Defaults to bare "deno", resolved via PATH.
DENO_PATH=deno
# Master switch for the background cookie-refresher (opens Firefox periodically
# to keep YouTube auth cookies alive). Default: true.
COOKIE_REFRESH_ENABLED=true
# How long a freshly-refreshed cookie is considered fresh (seconds). Default: 129600 (36h).
COOKIE_FRESH_TTL_SECS=129600
# How often the cookie worker checks for stale profiles (seconds). Default: 600 (10min).
COOKIE_WORKER_INTERVAL_SECS=600
# Refresh lock TTL, so dev and prod never open the same Firefox profile at once
# (seconds). Default: 1800 (30min).
COOKIE_REFRESH_LOCK_TTL_SECS=1800
# OS user the cookie-refresher spawns Firefox as (via `sudo -u <user>`), needed
# when the bot runs as root but the Firefox profile belongs to a desktop user.
# Leave unset to spawn Firefox directly as the bot's own user.
COOKIE_REFRESH_OS_USER=
# X display the cookie-refresher opens Firefox on. Default: :0
COOKIE_REFRESH_DISPLAY=:0
# XDG_RUNTIME_DIR passed to the spawned Firefox process. Leave unset to omit it.
COOKIE_REFRESH_XDG_RUNTIME_DIR=

# ── PDF compression tool ─────────────────────────────────────────────────────
# Max accepted PDF size in MB. Default: 2048 (2GB).
PDF_COMPRESS_MAX_MB=2048
# Hard timeout for the `gs` subprocess in seconds. Default: 1800 (30min).
PDF_COMPRESS_TIMEOUT_SECS=1800

# ── IP lookup tool ───────────────────────────────────────────────────────────
# ipinfo.io API token — source omitted from the IP lookup card when unset.
IPINFO_TOKEN=
# AbuseIPDB API key — source omitted from the IP lookup card when unset.
ABUSEIPDB_KEY=
# How often the cloud/Tor/Spamhaus static lists refresh (seconds). Default: 21600 (6h).
IP_LISTS_REFRESH_SECS=21600
