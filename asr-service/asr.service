[Unit]
Description=Nemotron ASR Service
After=network.target

[Service]
User=mahdi
WorkingDirectory=/home/mahdi/asr_service
ExecStart=/home/mahdi/asr_service/venv/bin/uvicorn asr_service:app --host 127.0.0.1 --port 8765 --workers 1
Restart=always
RestartSec=5
Environment=ASR_MODEL_DIR=/opt/asr_model
Environment=SEPARATION_SERVICE_DIR=/mnt/data/mahdidev/ros/dev/separation-service

[Install]
WantedBy=multi-user.target
